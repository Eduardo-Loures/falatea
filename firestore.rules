rules_version = '2';

// Regras do Firestore para o FalaTEA.
// Cada usuário só pode ler/escrever os próprios dados, guardados em
// usuarios/{uid}, usuarios/{uid}/perfis/{perfilId} e
// usuarios/{uid}/perfis/{perfilId}/categorias/{categoriaId}.

service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /perfis/{perfilId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /categorias/{categoriaId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // Qualquer outro caminho fica bloqueado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
